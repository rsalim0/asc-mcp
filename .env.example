# App Store Connect API credentials
# Create an API key at https://appstoreconnect.apple.com/access/api with Admin or App Manager role
# Download the .p8 file (you can only download once)

APP_STORE_CONNECT_KEY_ID=ABCD1234EF
APP_STORE_CONNECT_ISSUER_ID=12345678-1234-1234-1234-123456789012
APP_STORE_CONNECT_P8_PATH=/absolute/path/to/AuthKey_ABCD1234EF.p8

# Optional: inline the .p8 contents instead of a file path
# (use \n for newlines if your shell escapes them)
# APP_STORE_CONNECT_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Optional: required only for sales/finance reports
# APP_STORE_CONNECT_VENDOR_NUMBER=80000000000
