{
  "name": "asc-mcp-pro",
  "version": "0.1.2",
  "description": "MCP server exposing 191 tools across the App Store Connect API — apps, versions, builds, TestFlight, IAP/subscriptions, pricing, screenshots, certs, reports, plus high-level workflow macros and a declarative workflow runner.",
  "type": "module",
  "bin": {
    "asc-mcp-pro": "./build/index.js"
  },
  "files": [
    "build",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-all.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "app-store-connect",
    "appstore",
    "ios",
    "testflight",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsalim0/asc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rsalim0/asc-mcp/issues"
  },
  "homepage": "https://github.com/rsalim0/asc-mcp#readme",
  "author": "rsalim0",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
